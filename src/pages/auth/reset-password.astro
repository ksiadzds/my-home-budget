---
/**
 * Strona resetowania hasła
 *
 * @page /auth/reset-password
 * @description
 * Strona z dwu-etapowym przepływem resetowania hasła:
 * 1. Żądanie linku (formularz z emailem)
 * 2. Ustawienie nowego hasła (po kliknięciu w link z maila)
 *
 * Wykorzystuje główny Layout i komponent ResetPasswordForm (React).
 *
 * @remarks
 * Komponent automatycznie wykrywa obecność parametru `code` w URL
 * i na tej podstawie wyświetla odpowiedni widok formularza.
 *
 * ## Przepływ resetowania hasła:
 *
 * ### Krok 1 - Żądanie linku:
 * - Użytkownik wpisuje email na `/auth/reset-password`
 * - POST /api/auth/reset-password (action: 'request')
 * - Komunikat: "Jeśli email istnieje, wysłaliśmy link"
 *
 * ### Krok 2 - Nowe hasło:
 * - Kliknięcie linku z maila → `/auth/reset-password?code=...`
 * - Formularz: newPassword, confirmPassword
 * - POST /api/auth/reset-password (action: 'confirm')
 * - Redirect do `/auth/login?reset=success`
 *
 * ## Security:
 * - Nie ujawnia istnienia emaila przy reset hasła
 * - Token code jest jednorazowy i ma ograniczony czas życia
 * - Wymuszenie min. 8 znaków hasła
 *
 * @version 1.0.0 MVP
 * @since 2025-01-21
 */

import Layout from "@/layouts/Layout.astro";
import { ResetPasswordForm } from "@/components/auth/ResetPasswordForm";

// Sprawdź czy użytkownik jest już zalogowany
const { user } = Astro.locals;
if (user) {
  return Astro.redirect("/");
}
---

<Layout>
  <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 flex items-center justify-center p-4 sm:p-8">
    <div class="w-full max-w-md">
      <!-- Formularz resetowania hasła (request lub confirm) -->
      <ResetPasswordForm client:load />
    </div>
  </div>
</Layout>
