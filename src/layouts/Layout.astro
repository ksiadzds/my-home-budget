---
import "../styles/global.css";
import { LogoutButton } from "@/components/auth/LogoutButton";

interface Props {
  title?: string;
}

const { title = "My Home Budget" } = Astro.props;

// Pobierz informacje o zalogowanym użytkowniku z middleware
const user = Astro.locals.user;

// Określ aktywną stronę na podstawie URL
const currentPath = Astro.url.pathname;
const isProductsPage = currentPath === '/products' || currentPath === '/products/';
const isDashboardPage = currentPath === '/' || currentPath === '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Nawigacja - wyświetlana tylko dla zalogowanych użytkowników -->
    {user && (
      <header class="border-b border-slate-200 bg-white dark:bg-slate-900 dark:border-slate-800">
        <nav class="container mx-auto px-4 py-4 flex items-center justify-between">
          <!-- Logo / Nazwa aplikacji -->
          <div class="flex items-center space-x-6">
            <h1 class="text-xl font-bold text-slate-900 dark:text-white">
              My Home Budget
            </h1>
            
            <!-- Linki nawigacyjne -->
            <div class="hidden md:flex items-center space-x-4">
              <a 
                href="/" 
                class:list={[
                  "text-sm font-medium transition-colors",
                  isDashboardPage 
                    ? "text-slate-900 dark:text-white border-b-2 border-slate-900 dark:border-white pb-1" 
                    : "text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
                ]}
              >
                Dashboard
              </a>
              <a 
                href="/products" 
                class:list={[
                  "text-sm font-medium transition-colors",
                  isProductsPage 
                    ? "text-slate-900 dark:text-white border-b-2 border-slate-900 dark:border-white pb-1" 
                    : "text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white"
                ]}
              >
                Produkty
              </a>
            </div>
          </div>

          <!-- Informacje o użytkowniku i przycisk wylogowania -->
          <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-2">
              <div class="flex flex-col items-end">
                <span class="text-sm font-medium text-slate-900 dark:text-white">
                  {user.email}
                </span>
              </div>
            </div>
            <LogoutButton client:load />
          </div>
        </nav>
      </header>
    )}

    <!-- Główna treść strony -->
    <main class="min-h-screen">
      <slot />
    </main>
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    min-height: 100vh;
  }
  
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
</style>
